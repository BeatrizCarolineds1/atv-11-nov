<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"

    >
 <ImageView
     android:layout_width="match_parent"
     android:layout_height="wrap_content"
    android:src="@drawable/controle_de_estudos"


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Controle de estudos"
        android:textSize="40dp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:textColor="#4667DB"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Controle de estudos"
        android:textSize="25dp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:textColor="#3655A4"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Desenvolvido por:"
        android:textSize="20dp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:textColor="#000000"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gabriela Viviane e Beatriz"
        android:textSize="20dp"
        android:textStyle="italic"
        android:layout_gravity="center_horizontal"
        android:textColor="#000000"
        />

    <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Carregando..."
    android:textSize="20dp"
    android:textStyle="normal"
    android:layout_gravity="center_horizontal"
    android:textColor="#000000"
        android:layout_marginTop="20dp"
    />
    <ProgressBar
        android:id="@+id/carregando"
        android:layout_width="40dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="center"
        android:indeterminateTint="#052C6B"
        />





</LinearLayout>